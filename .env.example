# ─────────────────────────────────────────────
#  IoT Air Quality Monitoring System - Config
# ─────────────────────────────────────────────

# Flask
FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=iot_aqms_secret_2024

# MQTT Broker
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_USERNAME=aqms_user
MQTT_PASSWORD=aqms_pass
MQTT_TOPIC_PREFIX=aqms/sensors

# InfluxDB
INFLUXDB_URL=http://localhost:8086
INFLUXDB_TOKEN=your_influxdb_token
INFLUXDB_ORG=aqms_org
INFLUXDB_BUCKET=air_quality

# SQLite (local fallback)
DATABASE_URL=sqlite:///data/aqms.db


# Alert Thresholds (AQI)
AQI_GOOD=50
AQI_MODERATE=100
AQI_UNHEALTHY_SENSITIVE=150
AQI_UNHEALTHY=200
AQI_VERY_UNHEALTHY=300



# Email Alerts
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
ALERT_RECIPIENTS=admin@example.com,health@example.com

# Twilio SMS (optional)
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_token
TWILIO_FROM_NUMBER=+1234567890
ALERT_PHONE_NUMBERS=+919876543210

# Sensor Settings
SENSOR_READ_INTERVAL=30
DATA_RETENTION_DAYS=365
ML_RETRAIN_INTERVAL_HOURS=24

# Map / Location
DEFAULT_LAT=28.4595
DEFAULT_LON=77.0266
DEFAULT_CITY=Bhiwadi, Rajasthan
